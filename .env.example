# ==============================================================================
# MaternaVault Docker Environment Configuration
# ==============================================================================

# PostgreSQL Configuration (Docker container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=maternal_vault

# Edge Station Encryption & Offline Secrets
STATION_MASTER_KEY=MATERNA_VAULT_SECURE_PHM_MUM_71_SECRET_KEY
OFFLINE_TOKEN_SECRET=MATERNA_VAULT_OFFLINE_STATION_HMAC_SECRET_9876

# Database Connection URL (defaults to internal Docker postgres service)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/maternal_vault
